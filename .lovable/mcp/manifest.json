{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ttyoragcdcfqzcorphja.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "assingment-tracker",
      "version": "0.1.0",
      "title": "Assingment tracker"
    },
    "tools": [
      {
        "name": "list_assignments",
        "title": "List assignments",
        "description": "List the student's assignments with deadline, priority score (0-100) and progress, highest priority first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List planned tasks, optionally for one assignment and/or only incomplete ones, ordered by due date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "assignment_id": {
              "description": "Assignment ID from list_assignments; omit for all assignments.",
              "type": "string"
            },
            "only_open": {
              "description": "If true, only return tasks not yet completed.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_task_completed",
        "title": "Mark task done / not done",
        "description": "Set whether a task is completed.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "description": "Task ID from list_tasks."
            },
            "completed": {
              "type": "boolean",
              "description": "true = done, false = not done."
            }
          },
          "required": [
            "task_id",
            "completed"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_task",
        "title": "Add task",
        "description": "Add a task to an assignment's plan.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "assignment_id": {
              "type": "string",
              "description": "Assignment ID from list_assignments."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Task title."
            },
            "due_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Due date, YYYY-MM-DD."
            },
            "estimated_minutes": {
              "description": "Estimated minutes (default 60).",
              "type": "integer",
              "minimum": 5,
              "maximum": 1440
            },
            "description": {
              "description": "Optional details.",
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "assignment_id",
            "title",
            "due_date"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
